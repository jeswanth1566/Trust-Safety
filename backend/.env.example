# ----- Backend environment configuration -----
# Copy this file to `.env` and fill in real values.

# Security
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MongoDB Atlas (or local). Leave the default for a local mongod instance.
# Atlas example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=trustsafety

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Seed an initial admin account on startup (optional)
SEED_ADMIN_EMAIL=admin@trustsafe.ai
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Maya Chen
